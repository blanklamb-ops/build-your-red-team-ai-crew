{
  "manifest_version": 3,
  "name": "Chrome MV3 Auth Flow Lab Kit",
  "version": "1.0.0",
  "description": "Lab documentation kit for authorized security research - records auth flow metadata for phishlet generation",
  "permissions": [
    "webRequest",
    "webNavigation",
    "storage",
    "downloads"
  ],
  "optional_permissions": [],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Auth Flow Recorder"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content-script.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "host_permissions": []
}
