{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Sanitized lab authentication-flow capture",
  "type": "object",
  "required": ["session_id", "started_at", "events"],
  "additionalProperties": true,
  "properties": {
    "session_id": {"type": "string", "minLength": 1},
    "started_at": {"type": "string", "minLength": 1},
    "stopped_at": {"type": ["string", "null"]},
    "recording": {"type": "boolean"},
    "requested_origins": {"type": "array", "items": {"type": "string"}},
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["url", "source"],
        "properties": {
          "url": {"type": "string"},
          "method": {"type": "string"},
          "status": {"type": "number"},
          "resource_type": {"type": "string"},
          "source": {"type": "string"},
          "request_header_names": {"type": "array", "items": {"type": "string"}},
          "response_header_names": {"type": "array", "items": {"type": "string"}},
          "set_cookie_names": {"type": "array", "items": {"type": "string"}},
          "form_fields": {"type": "array"}
        }
      }
    },
    "diagnostics": {"type": "object"},
    "coverage": {"type": "string", "enum": ["complete", "incomplete"]}
  }
}
