{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Evilginx 2.3.0 Phishlet (study reference)",
  "description": "Reference schema aligned with https://github.com/kgretzky/evilginx2/wiki/Phishlet-File-Format-(2.3.0). Generators must ship an equivalent schema under schemas/ and validate against it.",
  "type": "object",
  "required": [
    "author",
    "min_ver",
    "proxy_hosts",
    "auth_tokens",
    "auth_urls",
    "login",
    "credentials",
    "sub_filters"
  ],
  "additionalProperties": false,
  "properties": {
    "author": { "type": "string", "minLength": 1 },
    "min_ver": { "type": "string", "const": "2.3.0" },
    "proxy_hosts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["phish_sub", "orig_sub", "domain", "session", "is_landing", "auto_filter"],
        "additionalProperties": false,
        "properties": {
          "phish_sub": { "type": "string" },
          "orig_sub": { "type": "string" },
          "domain": { "type": "string", "minLength": 1 },
          "session": { "type": "boolean" },
          "is_landing": { "type": "boolean" },
          "auto_filter": { "type": "boolean" }
        }
      }
    },
    "auth_tokens": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["domain", "keys"],
        "additionalProperties": false,
        "properties": {
          "domain": { "type": "string", "minLength": 1 },
          "keys": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "auth_urls": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "login": {
      "type": "object",
      "required": ["domain", "path"],
      "additionalProperties": false,
      "properties": {
        "domain": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 }
      }
    },
    "credentials": {
      "type": "object",
      "required": ["username", "password"],
      "additionalProperties": false,
      "properties": {
        "username": {
          "type": "object",
          "required": ["key", "search", "type"],
          "additionalProperties": false,
          "properties": {
            "key": { "type": "string", "minLength": 1 },
            "search": { "type": "string", "minLength": 1 },
            "type": { "type": "string", "enum": ["post", "json"] }
          }
        },
        "password": {
          "type": "object",
          "required": ["key", "search", "type"],
          "additionalProperties": false,
          "properties": {
            "key": { "type": "string", "minLength": 1 },
            "search": { "type": "string", "minLength": 1 },
            "type": { "type": "string", "enum": ["post", "json"] }
          }
        },
        "custom": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["key", "search", "type"],
            "properties": {
              "key": { "type": "string" },
              "search": { "type": "string" },
              "type": { "type": "string", "enum": ["post", "json"] }
            }
          }
        }
      }
    },
    "sub_filters": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["triggers_on", "orig_sub", "domain", "search", "replace", "mimes"],
        "properties": {
          "triggers_on": { "type": "string", "minLength": 1 },
          "orig_sub": { "type": "string" },
          "domain": { "type": "string", "minLength": 1 },
          "search": { "type": "string", "minLength": 1 },
          "replace": { "type": "string", "minLength": 1 },
          "mimes": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "redirect_only": { "type": "boolean" },
          "with_params": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    }
  }
}
