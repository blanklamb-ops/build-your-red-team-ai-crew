{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.invalid/schemas/profile_stub_input.schema.json",
  "title": "MalleableProfileStubInput",
  "description": "Observed URL patterns used to draft a commented malleable-C2-style profile skeleton. Output is a documentation stub, not a working production profile.",
  "type": "object",
  "required": ["profile_label", "observed_patterns"],
  "additionalProperties": false,
  "properties": {
    "profile_label": { "type": "string", "minLength": 1 },
    "observed_patterns": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["uri_path"],
        "properties": {
          "uri_path": { "type": "string" },
          "method": { "type": "string", "enum": ["GET", "POST"] },
          "content_type": { "type": "string" },
          "note": { "type": "string" }
        }
      }
    },
    "notes": { "type": "string" }
  }
}
