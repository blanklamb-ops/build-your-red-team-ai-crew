[
  {
    "name": "private_key",
    "pattern": "-----BEGIN [^-\\r\\n]*PRIVATE KEY-----[\\s\\S]*?-----END [^-\\r\\n]*PRIVATE KEY-----",
    "replacement": "[REDACTED PRIVATE KEY]"
  },
  {
    "name": "bearer_token",
    "pattern": "\\bBearer\\s+[A-Za-z0-9._~+/=-]+",
    "replacement": "[REDACTED BEARER TOKEN]"
  },
  {
    "name": "key_value_secret",
    "pattern": "\\b(?:api[_-]?key|password|secret|token)\\s*[:=]\\s*[^\\s,;]+",
    "replacement": "[REDACTED SECRET]"
  },
  {
    "name": "email_address",
    "pattern": "\\b[A-Z0-9._%+-]+@[A-Z0-9.-]+\\.[A-Z]{2,}\\b",
    "replacement": "[REDACTED EMAIL]"
  },
  {
    "name": "fixture_canary",
    "pattern": "PLANTED_SECRET_[A-Z0-9_]+",
    "replacement": "[REDACTED FIXTURE SECRET]"
  }
]
